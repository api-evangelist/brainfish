{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brainfish Public Agents Collections API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List collections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brainfi.sh/v1/collections",
            "params": [
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Field to sort by"
              },
              {
                "name": "direction",
                "value": "",
                "type": "query",
                "description": "Sort direction"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (1-100)"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset for pagination"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all collections the authenticated user has access to.\n"
        },
        {
          "info": {
            "name": "Create collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.brainfi.sh/v1/collections",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new collection.\n"
        },
        {
          "info": {
            "name": "Get collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brainfi.sh/v1/collections/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Collection ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a collection by its ID.\n"
        },
        {
          "info": {
            "name": "Update collection",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.brainfi.sh/v1/collections/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Collection ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing collection. Only provided fields will be updated.\n"
        },
        {
          "info": {
            "name": "Delete collection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.brainfi.sh/v1/collections/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Collection ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a collection. This will also delete all documents within the collection.\nCannot delete the last collection in a team.\n"
        }
      ]
    }
  ],
  "bundled": true
}